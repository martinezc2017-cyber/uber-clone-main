{
  "expo": {
      "name": "Nextryde",
    "slug": "nextryde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "sdkVersion": "54.0.0",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f80ed"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.arushsingh03.nextryde",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCfY-wxJaGf036soqLFYhQCCHHFJcK4SyE"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show your current position on the map and find nearby rides."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCfY-wxJaGf036soqLFYhQCCHHFJcK4SyE"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://nextryde.com/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://nextryde.com/"
      },
      "EXPO_PUBLIC_GOOGLE_API_KEY": "AIzaSyCfY-wxJaGf036soqLFYhQCCHHFJcK4SyE"
    }
  }
}
